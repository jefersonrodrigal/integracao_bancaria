# Copie para .env e ajuste. Nunca versione o .env.
IB_ENVIRONMENT=development
# Obrigatório: somente PostgreSQL.
IB_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/integracao_bancaria
IB_STORAGE_DIR=./data/files
IB_MAX_UPLOAD_BYTES=5242880
IB_LOG_LEVEL=INFO
# ator:papel:chave (papéis: reader, operator, admin). Chaves com 16+ caracteres.
IB_API_KEYS=admin:admin:troque-esta-chave-admin,operacao:operator:troque-esta-chave-operador
# Somente para pytest: banco PostgreSQL EXCLUSIVO de testes (o esquema é recriado a cada teste).
IB_TEST_DATABASE_URL=postgresql+psycopg://USUARIO:SENHA@localhost:5432/integracao_bancaria_test
